{
  "name": "pokemon-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "data:smoke": "node scripts/data/cli.ts",
    "data:test": "node --test --test-concurrency=1 scripts/data/tests/smoke.test.ts scripts/data/tests/full-dry-run.test.ts scripts/data/tests/excel-cross-validation.test.ts scripts/data/tests/conflict-resolution.test.ts scripts/data/tests/registry-review.test.ts scripts/data/tests/form-review-round1.test.ts scripts/data/tests/mechanics-resolution.test.ts scripts/data/tests/tags.test.ts scripts/data/tests/runtime-emission.test.ts scripts/data/tests/type-matchup.test.ts scripts/data/tests/stat-calculator.test.ts scripts/data/tests/experience-calculator.test.ts",
    "data:determinism": "node scripts/data/determinism.ts",
    "data:full": "node scripts/data/full-dry-run-cli.ts",
    "data:full:test": "node --test scripts/data/tests/full-dry-run.test.ts",
    "data:full:determinism": "node scripts/data/full-dry-run-determinism.ts",
    "data:tags": "node scripts/data/tags-migration-cli.ts",
    "data:tags:test": "node --test scripts/data/tests/tags.test.ts",
    "data:tags:determinism": "node scripts/data/tags-migration-determinism.ts",
    "data:runtime": "node scripts/data/runtime-emission-cli.ts",
    "data:runtime:test": "node --test --test-concurrency=1 scripts/data/tests/runtime-emission.test.ts",
    "data:type:test": "node --test --test-concurrency=1 scripts/data/tests/type-matchup.test.ts",
    "data:stat:test": "node --test --test-concurrency=1 scripts/data/tests/stat-calculator.test.ts",
    "data:experience:test": "node --test --test-concurrency=1 scripts/data/tests/experience-calculator.test.ts",
    "data:excel": "node scripts/data/excel-cross-validation-cli.ts",
    "data:excel:test": "node --test scripts/data/tests/excel-cross-validation.test.ts",
    "data:excel:determinism": "node scripts/data/excel-cross-validation-determinism.ts",
    "data:conflicts": "node scripts/data/conflict-resolution-cli.ts",
    "data:conflicts:determinism": "node scripts/data/conflict-resolution-determinism.ts",
    "data:mechanics": "node scripts/data/mechanics-resolution-cli.ts",
    "data:mechanics:determinism": "node scripts/data/mechanics-resolution-determinism.ts",
    "data:registry:plan": "node scripts/data/registry-review-cli.ts --plan",
    "data:registry:apply": "node scripts/data/registry-review-cli.ts --apply",
    "data:registry:determinism": "node scripts/data/registry-review-determinism.ts",
    "data:form-review:plan": "node scripts/data/form-review-round1-cli.ts --plan",
    "data:form-review:apply": "node scripts/data/form-review-round1-cli.ts --apply",
    "data:form-review:determinism": "node scripts/data/form-review-round1-determinism.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "zod": "4.4.3"
  }
}
